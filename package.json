{
	"name": "@mxmauro/iot-comm.js",
	"version": "0.1.7",
	"description": "Javascript library to communicate with ESP IoT devices using the IoT-Comm library",
	"license": "MIT",
	"author": "Mauro H. Leggieri",
	"type": "module",
	"main": "./dist/node/index.cjs",
	"module": "./dist/node/index.js",
	"types": "./dist/node/client.d.ts",
	"browser": "./dist/browser/index.min.js",
	"exports": {
		".": {
			"browser": {
				"import": "./dist/browser/index.min.js",
				"types": "./dist/browser/client.d.ts"
			},
			"node": {
				"import": "./dist/node/index.js",
				"require": "./dist/node/index.cjs",
				"types": "./dist/node/client.d.ts"
			},
			"default": {
				"import": "./dist/node/index.js",
				"require": "./dist/node/index.cjs",
				"types": "./dist/node/client.d.ts"
			}
		},
		"./umd": "./dist/umd/index.min.js"
	},
	"files": [
		"dist",
		"package.json",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"iot",
		"websocket",
		"communication",
		"browser",
		"node"
	],
	"homepage": "https://github.com/mxmauro/iot-comm.js",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mxmauro/iot-comm.js.git"
	},
	"scripts": {
		"build": "biome check && rimraf -I ./dist && cross-env NODE_ENV=production rslib build",
		"build:doctor": "cross-env RSDOCTOR=true npm run build",
		"biome:check": "biome check --verbose",
		"biome:format": "biome format --fix",
		"example:browser": "wds --config web-dev-server.config.mjs"
	},
	"dependencies": {
		"eventemitter3": "^5.0.4",
		"events": "^3.3.0",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@rsbuild/plugin-node-polyfill": "^1.4.6",
		"@rsbuild/plugin-type-check": "^1.6.0",
		"@rsdoctor/rspack-plugin": "^1.6.2",
		"@rslib/core": "^0.23.2",
		"@types/node": "^26.2.0",
		"@types/ws": "^8.18.1",
		"@web/dev-server": "^1.0.0",
		"cross-env": "^10.1.0",
		"rimraf": "^6.1.3",
		"typescript": "^7.0.2"
	},
	"optionalDependencies": {
		"bufferutil": "^4.1.0"
	}
}
